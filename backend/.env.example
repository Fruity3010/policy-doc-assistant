# Which model provider to use: gemini (default) or ollama
LLM_PROVIDER=gemini

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# --- Ollama (fully local: `ollama pull llama3.2 && ollama pull nomic-embed-text`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
HISTORY_TURNS=6
MAX_UPLOAD_MB=20

# Where Chroma + SQLite live (default: backend/data)
# DATA_DIR=./data

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
